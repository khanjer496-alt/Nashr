# ---------------------------------------------------------------------------
# Nashr — staging edge (Caddy 2).
#
# Same shape as production with two deliberate differences:
#   * basicauth in front of everything, so staging is never indexed, never
#     crawled, and never mistaken for production by a customer.
#   * X-Robots-Tag: noindex.
#
# Variables:
#   NASHR_STAGING_DOMAIN     e.g. staging.nashr.example
#   ACME_EMAIL               e.g. ops@nashr.example
#   STAGING_BASIC_AUTH_USER  e.g. nashr
#   STAGING_BASIC_AUTH_HASH  bcrypt hash, generate with:
#                              docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '<password>'
# ---------------------------------------------------------------------------

{
	email {$ACME_EMAIL}
	admin 127.0.0.1:2019
	servers {
		trusted_proxies static private_ranges
	}
}

{$NASHR_STAGING_DOMAIN} {
	basic_auth {
		{$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow, noarchive"
		-Server
	}

	encode zstd gzip

	request_body {
		max_size 2GB
	}

	reverse_proxy app:5000 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 300s
			write_timeout 300s
			dial_timeout 10s
		}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 5MiB
			roll_keep 3
		}
		format json
		level INFO
	}
}
