# =============================================================================
# Nashr (نشر) — environment reference
# =============================================================================
#
# Copy this file, never edit it in place:
#
#   cp .env.example .env.prod     && chmod 600 .env.prod       # production
#   cp .env.example .env.staging  && chmod 600 .env.staging    # staging
#   cp .env.example .env          && chmod 600 .env            # local dev
#
# Then:
#   ./ops/scripts/preflight.sh .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yaml up -d
#
# EVERY VALUE BELOW IS A PLACEHOLDER. There are no real credentials in this
# file and there must never be. `.gitignore` currently lists a bare `.env`,
# which does NOT match `.env.prod` or `.env.staging` — add a `.env.*` line
# before you create those files.
#
# Legend
#   [REQUIRED]  the stack will not start, or a core feature is dead, without it
#   [OPTIONAL]  a feature is switched off when it is absent
#   [DANGER]    read the comment in full before setting it
#
# Vars marked (build-time) are baked into the frontend bundle when the image is
# built. Changing them later needs a rebuild, not just a restart — see
# DEPLOYMENT.md "Build-time vs runtime configuration".
#
# Reference: DEPLOYMENT.md, SECURITY_CHECKLIST.md, AUDIT_REPORT.md §12.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. DEPLOYMENT IDENTITY
# -----------------------------------------------------------------------------

# [REQUIRED] Public hostname. Everything else is derived from it.
NASHR_DOMAIN="app.nashr.example"

# [REQUIRED for staging] Separate hostname for the staging stack.
NASHR_STAGING_DOMAIN="staging.nashr.example"

# [REQUIRED] Contact address Let's Encrypt uses for expiry warnings.
ACME_EMAIL="ops@nashr.example"

# [REQUIRED] The container image to run.
# NEVER use "latest" in production: a restart would silently change the running
# code. Use an immutable version tag. preflight.sh blocks "latest". (RISK-D3)
NASHR_IMAGE="ghcr.io/your-org/nashr-app"
NASHR_IMAGE_TAG="1.0.0"

# [REQUIRED for staging] Staging is never left open to the internet.
# Generate the hash with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
STAGING_BASIC_AUTH_USER="nashr"
# Single quotes are intentional: bcrypt hashes contain `$`, which Compose
# otherwise treats as variable interpolation and silently corrupts.
STAGING_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_A_REAL_BCRYPT_HASH'

# [OPTIONAL] Co-locating staging on the production host. Leave unset to use the
# standard 80/443 (which needs staging to have its own host).
# NASHR_STAGING_HTTP_PORT=8080
# NASHR_STAGING_HTTPS_PORT=8443


# -----------------------------------------------------------------------------
# 2. SECRETS  —  no defaults anywhere, generate every one of these
# -----------------------------------------------------------------------------

# [REQUIRED] Signs every session cookie and API token.
#
#   openssl rand -base64 48
#
# Upstream's docker-compose.yaml ships a literal placeholder here. Deploying
# that placeholder makes every account's session forgeable — this is RISK-S1,
# the single highest-impact configuration mistake available in this stack.
# Both preflight.sh and the container entrypoint refuse to proceed if this is
# short, absent, or a known placeholder string.
# Production and staging MUST use different values.
JWT_SECRET="GENERATE_ME_WITH_openssl_rand_base64_48"

# [REQUIRED] Database and cache passwords.
#
#   openssl rand -hex 24
#
# These are interpolated into postgres:// and redis:// URLs by the compose
# files, so restrict them to URL-safe characters: [A-Za-z0-9_.~-]
POSTGRES_USER="nashr"
POSTGRES_DB="nashr"
POSTGRES_PASSWORD="GENERATE_ME_WITH_openssl_rand_hex_24"
REDIS_PASSWORD="GENERATE_ME_WITH_openssl_rand_hex_24"
TEMPORAL_POSTGRES_PASSWORD="GENERATE_ME_WITH_openssl_rand_hex_24"


# -----------------------------------------------------------------------------
# 3. CORE URLS AND CONNECTIONS
#
# docker-compose.prod.yaml and docker-compose.staging.yaml SET ALL OF THESE
# THEMSELVES from NASHR_DOMAIN and the secrets above. Values here are only used
# for a bare-metal / local run. Anything you put here is overridden by compose.
# -----------------------------------------------------------------------------

# [REQUIRED] Postgres connection string.
DATABASE_URL="postgresql://nashr:CHANGE_ME@localhost:5432/nashr?schema=public"

# [REQUIRED] Redis connection string. Must begin with redis://
REDIS_URL="redis://localhost:6379"

# [REQUIRED] Temporal frontend address (host:port, no scheme).
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
# [OPTIONAL] Only for Temporal Cloud.
# TEMPORAL_TLS="true"
# TEMPORAL_API_KEY=""

# [REQUIRED] The URL customers type into the browser. All three must agree with
# reality or OAuth callbacks and cookies break in confusing ways.
MAIN_URL="http://localhost:4200"
FRONTEND_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"          # (build-time)
NEXT_PUBLIC_APP_URL="http://localhost:4200"              # (build-time)

# [REQUIRED] How the frontend reaches the backend INSIDE the container/host.
# Keep it loopback: it must never traverse the public internet.
BACKEND_INTERNAL_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"

# [REQUIRED] Upstream flag that enables the self-hosted feature set. Keep "true".
IS_GENERAL="true"

# [OPTIONAL] Ports. Defaults shown; the production image sets these itself.
# PORT=3000                  # backend
# ORCHESTRATOR_PORT=3002     # orchestrator health endpoint

# [OPTIONAL] Timezone. The backend forces UTC internally regardless.
# TZ="UTC"


# -----------------------------------------------------------------------------
# 4. SAFETY FLAGS  —  read every comment before changing one
# -----------------------------------------------------------------------------

# [DANGER] DO NOT SET THIS IN PRODUCTION — NOT EVEN TO "false".
#
# apps/backend/src/main.ts tests `!process.env.NOT_SECURED`. In JavaScript the
# STRING "false" is truthy, so `NOT_SECURED=false` TURNS THE INSECURE PATH ON:
# it drops cookie `credentials` from CORS and exposes the auth/showorg/
# impersonate headers cross-origin. The only safe state is the variable being
# absent. preflight.sh blocks its mere presence. (RISK-S2)
#
# NOT_SECURED=

# [DANGER] Disables the SSRF guard on outbound webhooks and on self-hosted
# provider URLs (WordPress, Mastodon, Lemmy, Listmonk, Bluesky PDS).
# With this on, a customer-supplied URL can reach Postgres, Redis, Temporal or
# the cloud metadata endpoint from inside your network.
# Compared with === 'true', so only the exact string "true" is dangerous.
# Leave it commented out. (RISK-S2)
#
# DISABLE_SSRF_PROTECTION=

# [RECOMMENDED in production] Closes public self-signup. For a 5-10 customer
# invite-only beta this should be "true" and you invite users from the admin UI.
# Compared with === 'true'.
DISABLE_REGISTRATION="true"

# [OPTIONAL] Blocks `user+tag@domain` signups (a common abuse vector).
# TRUTHINESS-TESTED: `DISALLOW_PLUS=false` ENABLES it. Comment it out to disable.
# DISALLOW_PLUS="true"

# [OPTIONAL] Skips client-side image compression before upload.
# Also truthiness-tested — comment out rather than setting "false".
# DISABLE_IMAGE_COMPRESSION="true"

# [OPTIONAL] Turns off X/Twitter analytics collection.
# DISABLE_X_ANALYTICS="true"

# [OPTIONAL] Only allow media whose path contains this string.
# RESTRICT_UPLOAD_DOMAINS=""

# [OPTIONAL] Public API rate limit, requests per hour per key. Default 90.
# A single global number is thin protection — see RISK-S6.
API_LIMIT=30


# -----------------------------------------------------------------------------
# 5. STORAGE
# -----------------------------------------------------------------------------

# [REQUIRED] "local" or "cloudflare".
#
# (build-time) — apps/frontend/next.config.js evaluates this when it builds its
# redirects/rewrites, so switching it needs an image REBUILD, not a restart.
#
#   local       media lives in the nashr-<env>-uploads Docker volume.
#               Back it up with ops/scripts/backup-uploads.sh.
#   cloudflare  media lives in Cloudflare R2. Recommended once you have real
#               customers: it survives host loss and serves media from the edge.
STORAGE_PROVIDER="local"

# --- STORAGE_PROVIDER=local ---
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY="/uploads"           # (build-time)

# --- STORAGE_PROVIDER=cloudflare (Cloudflare R2, S3-compatible) ---
# Create an R2 API token scoped to ONLY this bucket, with Object Read & Write.
# Do not reuse a global Cloudflare API key.
# CLOUDFLARE_ACCOUNT_ID="your-account-id"
# CLOUDFLARE_ACCESS_KEY="your-r2-access-key-id"
# CLOUDFLARE_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# CLOUDFLARE_BUCKETNAME="nashr-media"
# CLOUDFLARE_BUCKET_URL="https://media.nashr.example/"
# CLOUDFLARE_REGION="auto"


# -----------------------------------------------------------------------------
# 6. BACKUPS  (see BACKUP_AND_RECOVERY.md)
# -----------------------------------------------------------------------------

# [STRONGLY RECOMMENDED] Off-host backup target. Without it, backups live only
# on the production host and a host loss takes the backups with it (RISK-04).
# Use a SEPARATE R2 bucket and a SEPARATE token from the media bucket, with a
# bucket lifecycle rule for retention.
# BACKUP_R2_BUCKET="nashr-backups"
# BACKUP_R2_ACCOUNT_ID="your-account-id"
# BACKUP_R2_PREFIX="postgres/prod"

# Backup credentials are best kept OUT of this file entirely, in a root-owned
# 0600 /etc/nashr/backup.env loaded by ops/systemd/nashr-backup.service. That
# way a compromise of the app container cannot reach or delete the backups.
# BACKUP_R2_ACCESS_KEY_ID=""
# BACKUP_R2_SECRET_ACCESS_KEY=""


# -----------------------------------------------------------------------------
# 7. EMAIL  —  needed for activation, password reset and digests
# -----------------------------------------------------------------------------

# [REQUIRED if you want any email] "nodemailer" (SMTP) or "resend".
# With no provider configured, account activation emails silently never arrive.
EMAIL_PROVIDER="nodemailer"

EMAIL_FROM_ADDRESS="no-reply@nashr.example"
EMAIL_FROM_NAME="Nashr"

# --- EMAIL_PROVIDER=nodemailer (SMTP) ---
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"          # "true" for implicit TLS on port 465
EMAIL_USER="no-reply@nashr.example"
EMAIL_PASS="REPLACE_WITH_SMTP_PASSWORD"

# --- EMAIL_PROVIDER=resend ---
# RESEND_API_KEY="re_REPLACE_ME"


# -----------------------------------------------------------------------------
# 8. AI
# -----------------------------------------------------------------------------

# [OPTIONAL] Without it, AI copy generation and the agent features are off.
# The code falls back to the invalid stub "sk-proj-", which surfaces as a
# confusing runtime error rather than a startup failure (RISK-S5).
OPENAI_API_KEY=""

# [OPTIONAL] Model overrides for the Nashr agent layer. Default: gpt-5.2
# NASHR_AGENT_MODEL=""
# NASHR_AGENT_MODEL_FAST=""

# [OPTIONAL] fal.ai — image/video generation.
FAL_KEY=""

# [OPTIONAL] Tavily — web search for the agent.
TAVILY_API_KEY=""

# [OPTIONAL] Other generative providers.
# ELEVENSLABS_API_KEY=""
# KIEAI_API_KEY=""

# [OPTIONAL] Agent-to-backend auth. Generate like any other secret.
# AGENT_API_KEY=""
# AGENT_MEDIA_SSO_KEY=""


# -----------------------------------------------------------------------------
# 9. SOCIAL PLATFORM OAUTH
#
# Every platform needs its own developer app with the redirect URI:
#   https://<NASHR_DOMAIN>/integrations/social/<provider>
# Step-by-step per platform: DEPLOYMENT.md "OAuth application setup".
#
# Leave a pair empty and that channel simply does not appear to customers.
# For a UAE beta, start with: Instagram, Facebook, TikTok, LinkedIn, X, YouTube.
#
# Snapchat is NOT supported by any of the 36 providers (RISK-P1). Disclose that
# to every beta customer before they sign up.
# -----------------------------------------------------------------------------

# --- Meta: Facebook Pages + Instagram Business. One Meta app covers both.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# --- Threads (separate Meta app from Instagram)
THREADS_APP_ID=""
THREADS_APP_SECRET=""

# --- TikTok (requires app review before it will post to live accounts)
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""

# --- LinkedIn (personal profiles + company pages)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# --- X / Twitter (needs a paid API tier to post)
X_API_KEY=""
X_API_SECRET=""
X_URL=""
# STRIP_LINKS_FROM_X_POSTS="true"   # X down-ranks posts containing links

# --- YouTube (Google Cloud project + OAuth consent screen verification)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# --- Google Business Profile (valuable for UAE restaurants/salons/clinics)
GOOGLE_GMB_CLIENT_ID=""
GOOGLE_GMB_CLIENT_SECRET=""

# --- Pinterest
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""

# --- Telegram
TELEGRAM_BOT_NAME=""
TELEGRAM_TOKEN=""

# --- Discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN_ID=""

# --- Slack
SLACK_ID=""
SLACK_SECRET=""
SLACK_SIGNING_SECRET=""

# --- Reddit
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# --- Mastodon (self-hosted URL is fetched server-side; SSRF guard applies)
MASTODON_URL="https://mastodon.social"
MASTODON_CLIENT_ID=""
MASTODON_CLIENT_SECRET=""

# --- Remaining providers: out of scope for the UAE beta, listed for completeness
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DRIBBBLE_CLIENT_ID=""
DRIBBBLE_CLIENT_SECRET=""
TUMBLR_CLIENT_ID=""
TUMBLR_CLIENT_SECRET=""
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
KICK_CLIENT_ID=""
KICK_SECRET=""
VK_ID=""
WHOP_CLIENT_ID=""
MEWE_API_KEY=""
MEWE_APP_ID=""
MEWE_HOST=""
NEYNAR_CLIENT_ID=""
NEYNAR_SECRET_KEY=""
NEYNAR_LOGIN_URL=""
BEEHIIVE_API_KEY=""
BEEHIIVE_PUBLICATION_ID=""
LISTMONK_DOMAIN=""
LISTMONK_USER=""
LISTMONK_API_KEY=""
LISTMONK_LIST_ID=""
LISTMONK_WELCOME_TEMPLATE_ID=""

# --- Browser extension (cookie-based integrations such as Skool)
EXTENSION_ID=""


# -----------------------------------------------------------------------------
# 10. SSO INTO NASHR (generic OIDC, e.g. Authentik) — optional
# -----------------------------------------------------------------------------
# POSTIZ_GENERIC_OAUTH="false"
# POSTIZ_OAUTH_URL="https://auth.nashr.example"
# POSTIZ_OAUTH_AUTH_URL="https://auth.nashr.example/application/o/authorize"
# POSTIZ_OAUTH_TOKEN_URL="https://auth.nashr.example/application/o/token"
# POSTIZ_OAUTH_USERINFO_URL="https://auth.nashr.example/application/o/userinfo"
# POSTIZ_OAUTH_CLIENT_ID=""
# POSTIZ_OAUTH_CLIENT_SECRET=""
# POSTIZ_OAUTH_SCOPE="openid profile email"
# NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME="Nashr SSO"          # (build-time)
# NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=""                       # (build-time)


# -----------------------------------------------------------------------------
# 11. BILLING (Stripe) — optional until you charge anyone
# -----------------------------------------------------------------------------
# Use TEST keys (sk_test_/pk_test_) everywhere except production.
# The webhook endpoint is  https://<NASHR_DOMAIN>/api/stripe
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_SIGNING_KEY_CONNECT=""
# STRIPE_DISCOUNT_ID=""


# -----------------------------------------------------------------------------
# 12. OBSERVABILITY — optional but strongly recommended before customers arrive
# -----------------------------------------------------------------------------

# Sentry. NEXT_PUBLIC_SENTRY_DSN is (build-time).
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""        # build machine only; do NOT ship to the runtime
# SENTRY_SPOTLIGHT="1"        # local debugging only, never production

# PostHog / GTM / Facebook Pixel — all (build-time).
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# NEXT_PUBLIC_GTM_ID=""
# NEXT_PUBLIC_FACEBOOK_PIXEL=""
# FACEBOOK_PIXEL_ACCESS_TOKEN=""
# DATAFAST_API_KEY=""
# DATAFAST_WEBSITE_ID=""
# CHATBASE_TOKEN=""


# -----------------------------------------------------------------------------
# 13. BRAND AND LEGAL  —  all (build-time)
# -----------------------------------------------------------------------------

# [REQUIRED BEFORE ANY CUSTOMER USES THE PRODUCT]
#
# Nashr derives from Postiz, which is AGPL-3.0. Section 13 obliges you to offer
# the Corresponding Source — including your modifications — to every user who
# interacts with it over a network. This variable is that offer.
#
# If it is empty the app falls back to the UPSTREAM Postiz repository, which is
# NOT the corresponding source for your build, and the obligation is unmet.
# Point it at a public mirror of THIS deployment's source. (RISK-L1)
NEXT_PUBLIC_SOURCE_URL="https://github.com/your-org/nashr"

NEXT_PUBLIC_BRAND_LEGAL_NAME="Your Company FZ-LLC"
NEXT_PUBLIC_BRAND_JURISDICTION="Dubai, United Arab Emirates"
NEXT_PUBLIC_BRAND_GOVERNING_LAW="the laws of the United Arab Emirates"
NEXT_PUBLIC_SUPPORT_EMAIL="support@nashr.example"
NEXT_PUBLIC_PRIVACY_EMAIL="privacy@nashr.example"
# NEXT_PUBLIC_DOCS_URL="https://docs.nashr.example"
# NEXT_PUBLIC_VERSION=""          # set from NASHR_IMAGE_TAG at build time
# NEXT_PUBLIC_DISCORD_SUPPORT=""
# NEXT_PUBLIC_POLOTNO=""          # Polotno design-editor licence key


# -----------------------------------------------------------------------------
# 14. WORKERS AND SCHEDULING
# -----------------------------------------------------------------------------

# [OPTIONAL] Comma-separated Temporal task queues this instance must NOT poll.
# Use it to split publishing onto a dedicated worker host once one box is not
# enough. Empty means "poll everything", which is right for a 5-10 customer beta.
# EXCLUDE_QUEUE=""

# [OPTIONAL] Divides Temporal worker concurrency. Raise to 2 or 4 if the app
# container is CPU-starved. Default 1.
# WORKER_CONCURRENCY_DIVIDER=1

# [OPTIONAL] Registers the recurring (cron) workflows. TRUTHINESS-TESTED —
# `RUN_CRON=false` still enables it. Exactly ONE instance should have this set.
# RUN_CRON="true"


# -----------------------------------------------------------------------------
# 15. SHORT LINKS — optional
# -----------------------------------------------------------------------------
# DUB_TOKEN=""
# DUB_API_ENDPOINT="https://api.dub.co"
# DUB_SHORT_LINK_DOMAIN="dub.sh"
# SHORT_IO_SECRET_KEY=""
# KUTT_API_KEY=""
# KUTT_API_ENDPOINT="https://kutt.it/api/v2"
# KUTT_SHORT_LINK_DOMAIN="kutt.it"
# LINK_DRIP_API_KEY=""
# LINK_DRIP_API_ENDPOINT="https://api.linkdrip.com/v1/"
# LINK_DRIP_SHORT_LINK_DOMAIN="dripl.ink"


# -----------------------------------------------------------------------------
# 16. BUILD / DEVELOPMENT ONLY
# -----------------------------------------------------------------------------
NX_ADD_PLUGINS=false
# NODE_ENV="production"          # the production image sets this itself
# RUN_MIGRATIONS="true"          # set "false" only if a separate job runs
#                                # `prisma migrate deploy` before the app starts
