# TEMPLATE ONLY. Copy to .env.prod (chmod 600); never commit real credentials.
# Keep the app and all scheduler services on the same immutable source/image.
NASHR_DOMAIN="app.postdelegate.com"
NASHR_ENV_FILE=".env.prod"
NASHR_IMAGE="ghcr.io/khanjer496-alt/postdelegate"
NASHR_IMAGE_TAG=""
POSTDELEGATE_IMAGE_DIGEST=""
POSTDELEGATE_LAUNCH_MODE="lean"
# Empty until this deployment's actual access and publish tests are verified.
# Initial candidates: linkedin,facebook,instagram-standalone (or instagram).
POSTDELEGATE_ENABLED_PROVIDERS=""
DISABLE_REGISTRATION="true"
STORAGE_PROVIDER="cloudflare"
NEXT_PUBLIC_APP_URL="https://app.postdelegate.com"
NEXT_PUBLIC_BACKEND_URL="https://app.postdelegate.com/api"
NEXT_PUBLIC_SOURCE_URL=""
NEXT_PUBLIC_BRAND_LEGAL_NAME="Nasida Apps LLC"
NEXT_PUBLIC_BRAND_JURISDICTION="Wyoming, United States"
# No invented legal decisions or mailbox readiness.
NEXT_PUBLIC_BRAND_GOVERNING_LAW=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_PRIVACY_EMAIL=""
ACME_EMAIL=""
JWT_SECRET=""
POSTGRES_PASSWORD=""
REDIS_PASSWORD=""
TEMPORAL_POSTGRES_PASSWORD=""
TEMPORAL_NAMESPACE="default"
RUN_MIGRATIONS="true"
CLOUDFLARE_ACCOUNT_ID="6ada63eb2f8c926ce2d7254c91006e70"
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKETNAME="nashr-production-media"
CLOUDFLARE_BUCKET_URL=""
CLOUDFLARE_REGION="auto"
BACKUP_R2_BUCKET="nashr-production-backups"
# Backup writer credentials belong in the existing root-owned backup config,
# not in this application's environment. Keep backup bucket private.
# Set the existing email provider's variables only after domain verification.
# Do not add NOT_SECURED (even 'false') or DISABLE_SSRF_PROTECTION.
